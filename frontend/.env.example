# Salin ke .env.local lalu isi nilainya. .env.local TIDAK di-commit.
# Variabel NEXT_PUBLIC_* di-inline saat BUILD — set sebelum `bun run build`.

# URL backend FastAPI (tanpa trailing slash).
# Lokal: http://localhost:8000 — Produksi: https://<service-backend>.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase untuk login admin /quiz/admin. Hanya anon key; service_role tetap di backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email admin untuk badge di navbar (dipisah koma). Samakan dengan QUIZ_ADMIN_EMAILS
# di backend/.env. Alternatif: set app_metadata.role = "admin" pada user Supabase.
NEXT_PUBLIC_ADMIN_EMAILS=

# ID server Discord default untuk panel /admin (tombol "Tampilkan 5 berita acak").
# Boleh dikosongkan — isian tetap bisa diubah di panel.
NEXT_PUBLIC_DISCORD_GUILD_ID=

# Server-only (tanpa NEXT_PUBLIC_): dipakai route handler /api/discord/broadcast.
# Harus sama dengan DISCORD_BOT_API_KEY di backend. Jangan pakai prefix NEXT_PUBLIC_.
DISCORD_BOT_API_KEY=

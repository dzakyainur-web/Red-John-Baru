# Salin ke .env.local lalu isi nilainya. .env.local TIDAK di-commit.
# Variabel NEXT_PUBLIC_* di-inline saat BUILD — set di dashboard hosting
# sebelum `bun run build`, bukan setelahnya.

# URL backend FastAPI (tanpa trailing slash) [wajib].
# Lokal: http://localhost:8000 — Produksi: https://<service-backend>.up.railway.app
# Catatan: /berita di-prerender saat build dan mem-fetch GET /api/news,
# jadi build gagal bila URL ini tidak dapat dijangkau.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth [wajib]. Hanya anon key; service_role tetap di backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Badge admin di navbar mengikuti public.profiles.role di backend, jadi tidak ada
# env admin di sini. Promote lewat Supabase Table Editor (tabel profiles).

# ID server Discord default untuk panel /admin (tombol "Tampilkan 5 berita acak").
# Boleh dikosongkan — isian tetap bisa diubah di panel.
NEXT_PUBLIC_DISCORD_GUILD_ID=

# Server-only (tanpa NEXT_PUBLIC_): dipakai route handler /api/discord/broadcast.
# Harus sama dengan DISCORD_BOT_API_KEY di backend. Jangan pakai prefix NEXT_PUBLIC_.
DISCORD_BOT_API_KEY=

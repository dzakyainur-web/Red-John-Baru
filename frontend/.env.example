# Salin ke .env.local lalu isi nilainya. .env.local TIDAK di-commit.
# Variabel NEXT_PUBLIC_* di-inline saat BUILD — set sebelum `bun run build`.

# URL backend FastAPI (tanpa trailing slash).
# Lokal: http://localhost:8000 — Produksi: https://<service-backend>.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Salin ke .env lalu isi nilainya. .env TIDAK di-commit.
# Muat dengan: uv run --env-file .env <perintah>

# --- Supabase (wajib untuk news harvester + GET /api/news) ---
# Project Settings -> API -> Project URL (format https://<ref>.supabase.co)
SUPABASE_URL=
# Project Settings -> API -> service_role secret. RAHASIA: bypass RLS, jangan taruh di frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- News harvester ---
# Scheduler hanya hidup di proses scraper. Jalankan terpisah:
#   uv run scraper.py
# true = API (`uv run main.py`) ikut menjalankan scheduler (deploy satu container).
NEWS_SCHEDULER=false
# true = jalankan satu putaran harvest langsung saat API boot (bukan tunggu 6 jam)
NEWS_RUN_ON_START=true
NEWS_INTERVAL_HOURS=6

# --- CORS ---
# Pisahkan dengan koma. Default: http://localhost:3000
GUARDIANAI_CORS_ORIGINS=http://localhost:3000

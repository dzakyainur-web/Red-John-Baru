# Salin ke .env lalu isi nilainya. .env TIDAK di-commit.
# Dimuat internal/config lewat godotenv (opsional); env shell menang.
# Nilai durasi memakai format Go: 5s, 60s, 90s, 2m.

# ===== Discord [wajib] =====
# Token bot — Developer Portal > Bot > Reset Token. Rahasia, tidak pernah di-log.
DISCORD_TOKEN=
# Application ID — Developer Portal > General Information.
DISCORD_APP_ID=
# Opsional: scope pengembangan. Jika diisi, slash command hanya terdaftar di guild
# ini (instan). Kosongkan di produksi agar command global (propagasi ~1 jam).
DISCORD_GUILD_ID=

# ===== Backend Red John [wajib] =====
# URL backend FastAPI (tanpa trailing slash). Produksi: https://<domain-backend>
REDJOHN_API_URL=http://localhost:8000
# API key bot — harus sama dengan DISCORD_BOT_API_KEY di backend/.env
# (kosong + backend development = endpoint terbuka; produksi wajib diisi).
REDJOHN_API_KEY=

# ===== Runtime =====
# development | production
APP_ENV=development
# debug | info | warn | error (nilai lain = gagal start)
LOG_LEVEL=info
# Interval polling ancaman terverifikasi untuk alert
ALERT_POLL_INTERVAL=60s
# Interval polling outbox backend (post berita acak & pengumuman klasemen kuis)
BROADCAST_POLL_INTERVAL=5s
# Timeout HTTP ke backend (harus < deadline interaction Discord, 15 menit)
HTTP_TIMEOUT=9s

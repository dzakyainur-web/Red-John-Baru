# Token bot Discord (wajib) — dari Developer Portal > Bot
DISCORD_TOKEN=
# Application ID bot (wajib)
DISCORD_APP_ID=
# Opsional: scope pengembangan. Jika diisi, command hanya terdaftar di guild ini
# (instan). Kosongkan di produksi agar command global (propagasi ~1 jam).
DISCORD_GUILD_ID=

# URL backend FastAPI Red John (wajib)
REDJOHN_API_URL=http://localhost:8000
# API key bot — harus sama dengan DISCORD_BOT_API_KEY di backend/.env
REDJOHN_API_KEY=

# development | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# Interval polling ancaman terverifikasi untuk alert
ALERT_POLL_INTERVAL=60s
# Interval polling permintaan "post berita acak" dari panel admin web
BROADCAST_POLL_INTERVAL=5s
# Timeout HTTP ke backend (harus < deadline interaction Discord)
HTTP_TIMEOUT=9s
